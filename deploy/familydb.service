# systemd unit for FamilyDB without Docker; scripts/install.sh installs it with its own paths.
# By hand: copy to /etc/systemd/system/familydb.service, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now familydb
# Expects /opt/familydb with .venv (uv sync --frozen --no-dev); .env and data/ owned by familydb.

[Unit]
Description=FamilyDB family planning bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=familydb
Group=familydb
WorkingDirectory=/opt/familydb
EnvironmentFile=/opt/familydb/.env
Environment=FAMILYDB_PATH=/opt/familydb/data/familydb.sqlite3
Environment=GOOGLE_KEY_PATH=/opt/familydb/data/google_key.json
ExecStart=/opt/familydb/.venv/bin/familydb run
Restart=on-failure
RestartSec=5
# A lookup mid-API-call can take minutes to notice the stop; nothing is lost if killed.
TimeoutStopSec=150

# Hardening: only data/ writable, nothing readable by other accounts (the database holds every
# message and any key typed into the settings page).
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectSystem=strict
# Hides /home; for a checkout there use ProtectHome=read-only (the installer does).
ProtectHome=true
# WEB_PORT must stay above 1024: no capabilities, so no lower port can be bound.
ReadWritePaths=/opt/familydb/data

[Install]
WantedBy=multi-user.target
