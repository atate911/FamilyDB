# FamilyDB configuration. Copy to .env and fill in. Never commit .env.
# A line left empty means "not set", so the default applies; `cp .env.example .env` is a working
# file. A value with a space or a '#' in it needs quoting: WEB_PASSWORD='two words # three'.
# Everything is optional except one model key: ANTHROPIC_API_KEY, OPENAI_API_KEY or
# GEMINI_API_KEY, without which the bot can save a message but not answer it.
# Most of this can also be changed from the web page's settings form, without a restart; a value
# set there wins over the same one here. `familydb config` says which is which.

# --- Who answers ---
# anthropic, openai or gemini. WORKER_PROVIDER is for the lookup and discovery turns; leave it
# empty and they use PROVIDER too. With PROVIDER_FALLBACK on, a message the chosen one cannot
# take right now is tried on the next one that has a key.
PROVIDER=anthropic
WORKER_PROVIDER=
PROVIDER_FALLBACK=true

# --- Gemini, when you use it ---
GEMINI_API_KEY=
# Check these names against your own account; they are only defaults.
GEMINI_MODEL=gemini-2.5-pro
GEMINI_WORKER_MODEL=gemini-2.5-flash

# --- OpenAI, when you use it ---
OPENAI_API_KEY=
# Check these names against your own account; they are only defaults.
OPENAI_MODEL=gpt-5
OPENAI_WORKER_MODEL=gpt-5-mini

# --- Claude ---
ANTHROPIC_API_KEY=
# Model id; leave as is unless you have a reason to change it.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Medium keeps chat replies quick. Applies to whoever answers.
EFFORT=medium
# Caps one answer, on either provider.
MAX_OUTPUT_TOKENS=16000
# Re-run a declined request on a fallback model server-side (recommended).
ANTHROPIC_FALLBACKS=true
# Prompt cache lifetime: 1h (the default) or 5m. 1h costs more per write but survives the
# quiet gaps a family leaves between messages, which is most of them.
ANTHROPIC_CACHE_TTL=1h
# Safety cap on model round trips per message.
AGENT_MAX_ITERATIONS=8
# How much recent conversation the model sees: last N messages within N hours.
HISTORY_LIMIT=20
HISTORY_HOURS=6

# --- Home ---
# IANA timezone of the family, e.g. America/Los_Angeles or America/Vancouver.
# If unset, the OS TZ variable is used when it names an IANA zone; otherwise UTC.
FAMILYDB_TZ=America/Los_Angeles
# Where the database lives. Docker and systemd set this to their data folder.
FAMILYDB_PATH=data/familydb.sqlite3
# Coordinates enable the weather forecast; HOME_AREA is used in web searches.
HOME_LAT=
HOME_LON=
HOME_AREA=
# metric (C, mm) or imperial (F, inches) for forecasts.
WEATHER_UNITS=metric

# --- Optional services ---
# Server-side web search and fetch for enrichment and discovery.
WEB_TOOLS_ENABLED=false
# From BotFather. When set, `familydb run` polls Telegram.
TELEGRAM_BOT_TOKEN=
# In groups, only answer messages that @mention the bot or reply to it.
TELEGRAM_REQUIRE_MENTION=false
# The shared family calendar id (usually an email-like address) and the OAuth token file.
GOOGLE_CALENDAR_ID=
GOOGLE_TOKEN_PATH=data/google_token.json
# Post a one-line "filled in #57" note after an idea's details are looked up.
ENRICHMENT_NOTES=true
# Failed messages are retried this often, this many times.
RETRY_INTERVAL_MINUTES=5
RETRY_MAX_ATTEMPTS=3

# --- Enrichment, suggestions and scheduled prompts (need WEB_TOOLS_ENABLED=true for web lookups) ---
# How often the background job looks up new ideas, and how many per run.
ENRICH_INTERVAL_MINUTES=2
ENRICH_BATCH=3
# Place details older than this are re-checked when the idea is suggested.
PLACE_STALE_DAYS=30
# Model round trips allowed for a lookup or discovery turn.
WORKER_MAX_ITERATIONS=12
# The ideas list rides in the cached prompt on every message, so it cannot grow without end. Past
# this many ideas the oldest are left out and the model is told to search for them instead.
PROMPT_IDEA_LIMIT=150
# Looking a place up and finding events are extraction jobs: they run on a smaller, cheaper model
# with less thinking. Leave WORKER_MODEL empty to use ANTHROPIC_MODEL for those too.
WORKER_MODEL=claude-haiku-4-5-20251001
WORKER_EFFORT=low
# Travel-time estimate: straight-line distance times ROAD_FACTOR at TRAVEL_SPEED_KMH.
TRAVEL_SPEED_KMH=50
ROAD_FACTOR=1.3
# Telegram chat that receives the weekend digest (the family group). Group ids are negative.
# Once someone has written in the group, find it with:
#   sqlite3 data/familydb.sqlite3 "select distinct chat_id from messages where channel='telegram'"
# "web" sends it to the chat on the web page instead, which works from the first day because
# there is no id to look up. Leave empty to disable the digest. RUNBOOK section 9 has the rest.
DIGEST_CHAT_ID=
DIGEST_DAY=thu
DIGEST_HOUR=18
# Hour (family time) at which "how was it?" follow-ups are posted the day after a plan.
FOLLOW_UP_HOUR=10

# --- The web page ---
# The ideas list, the restaurants and the plans to browse, plus a status page and a settings page
# for everything in this file. Off by default. Ideas and plans are never changed from the page.
# Anything below can also be set from that page, where it wins over the value here.
WEB_ENABLED=false
# 127.0.0.1 keeps it on this machine (reach it over Tailscale or an SSH tunnel). Use 0.0.0.0 to
# serve the network. Must stay above port 1024: the process runs unprivileged.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# One shared password for the whole family. Required once WEB_HOST leaves the loopback, where it
# also has to be at least 12 characters. It guards the settings page and the keys too, so on a
# machine on the internet this is what stands between a stranger and your API bill.
WEB_PASSWORD=
# Signs the login cookie. Leave empty and one is generated beside the database; set it when more
# than one process serves the page, so a login works against either.
WEB_SECRET_KEY=
# How long a login lasts before the password is asked again.
WEB_SESSION_DAYS=30
# Serve the network with no password at all. Only for a home network you trust.
WEB_ALLOW_NO_PASSWORD=false
# Set to true only when a reverse proxy you control (Caddy, nginx) sits in front, so the real
# client address and the HTTPS scheme are read from its headers.
WEB_TRUST_PROXY=false
# What the page calls itself.
WEB_TITLE=FamilyDB
# Only for the compose "tls" profile: the domain name pointing at this machine, which Caddy gets
# a certificate for. Leave empty when not serving the page over HTTPS.
WEB_DOMAIN=

# --- Console and logging ---
# Who `familydb chat` speaks as when --as is not given. Default: the first admin.
CONSOLE_MEMBER=
# DEBUG also logs every HTTP request, and a Telegram request carries the bot token in its URL,
# so turn it back down when you are done reading.
LOG_LEVEL=INFO
