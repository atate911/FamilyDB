# FamilyDB configuration. scripts/install.sh writes .env from this file; never commit .env.
# Most of what is here is better set on the web page's settings form, which needs no restart
# and wins over the same value here: the keys, the models, Telegram, Google Calendar, where home
# is and the spending limit. What only this file can set is how the page itself is reached (the
# WEB_ lines below) and where the data lives. `familydb config` says where each value came from.
# A line left empty means "not set", so the default applies. A value with a space or a '#' in
# it needs quoting: WEB_PASSWORD='two words # three'.

# --- Who answers ---
# openai, anthropic or gemini. WORKER_PROVIDER is for the lookup and discovery turns; leave it
# empty and they use PROVIDER too. With PROVIDER_FALLBACK on, a message the chosen one cannot
# take right now is tried on the next one that has a key.
PROVIDER=openai
WORKER_PROVIDER=
PROVIDER_FALLBACK=true

# --- OpenAI, the default ---
OPENAI_API_KEY=
# GPT-6 Luna for chat and lookups alike: the cheapest capable model of the three companies.
# Any model name your account offers works; the settings page suggests the ones it knows.
OPENAI_MODEL=gpt-6-luna
OPENAI_WORKER_MODEL=gpt-6-luna

# --- Spending ---
# Estimated US dollars a day across every model call, in the family's timezone. Once reached,
# nothing more is asked of a model until midnight. 0 turns it off. Set a limit on the API key
# with the company as well: this one is an estimate, theirs is the bill.
DAILY_SPEND_LIMIT=2

# --- Gemini, when you use it ---
GEMINI_API_KEY=
# Check these names against your own account; they are only defaults.
GEMINI_MODEL=gemini-2.5-pro
GEMINI_WORKER_MODEL=gemini-3.8-flash

# --- Claude, when you use it ---
ANTHROPIC_API_KEY=
# Model id; leave as is unless you have a reason to change it.
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Medium keeps chat replies quick. Applies to whoever answers.
EFFORT=medium
# Caps one answer, on either provider.
MAX_OUTPUT_TOKENS=16000
# Re-run a declined request on a fallback model server-side (recommended).
ANTHROPIC_FALLBACKS=true
# Prompt cache lifetime: 1h (the default) or 5m. 1h costs more per write but survives the
# quiet gaps a family leaves between messages, which is most of them.
ANTHROPIC_CACHE_TTL=1h
# Safety cap on model round trips per message.
AGENT_MAX_ITERATIONS=8
# How much recent conversation the model sees: last N messages within N hours.
HISTORY_LIMIT=20
HISTORY_HOURS=6

# --- Home ---
# IANA timezone of the family, e.g. America/Los_Angeles or America/Vancouver.
# If unset, the OS TZ variable is used when it names an IANA zone; otherwise UTC.
FAMILYDB_TZ=America/Los_Angeles
# Where the database lives. Docker and systemd set this to their data folder.
FAMILYDB_PATH=data/familydb.sqlite3
# Coordinates enable the weather forecast; HOME_AREA is used in web searches.
HOME_LAT=
HOME_LON=
HOME_AREA=
# metric (C, mm) or imperial (F, inches) for forecasts.
WEATHER_UNITS=metric

# --- Optional services ---
# Server-side web search and fetch for enrichment and discovery.
WEB_TOOLS_ENABLED=false
# From BotFather. When set, `familydb run` polls Telegram.
TELEGRAM_BOT_TOKEN=
# In groups, only answer messages that @mention the bot or reply to it.
TELEGRAM_REQUIRE_MENTION=false
# The shared family calendar id (usually an email-like address) and the OAuth token file.
GOOGLE_CALENDAR_ID=
GOOGLE_TOKEN_PATH=data/google_token.json
# Post a one-line "filled in #57" note after an idea's details are looked up.
ENRICHMENT_NOTES=true
# Failed messages are retried this often, this many times.
RETRY_INTERVAL_MINUTES=5
RETRY_MAX_ATTEMPTS=3

# --- Enrichment, suggestions and scheduled prompts (need WEB_TOOLS_ENABLED=true for web lookups) ---
# How often the background job looks up new ideas, and how many per run.
ENRICH_INTERVAL_MINUTES=2
ENRICH_BATCH=3
# Place details older than this are re-checked when the idea is suggested.
PLACE_STALE_DAYS=30
# Model round trips allowed for a lookup or discovery turn.
WORKER_MAX_ITERATIONS=12
# The ideas list rides in the cached prompt on every message, so it cannot grow without end. Past
# this many ideas the oldest are left out and the model is told to search for them instead.
PROMPT_IDEA_LIMIT=150
# Looking a place up and finding events are extraction jobs: they run on a smaller, cheaper model
# with less thinking. Leave WORKER_MODEL empty to use ANTHROPIC_MODEL for those too.
WORKER_MODEL=claude-haiku-4-5-20251001
WORKER_EFFORT=low
# Travel-time estimate: straight-line distance times ROAD_FACTOR at TRAVEL_SPEED_KMH.
TRAVEL_SPEED_KMH=50
ROAD_FACTOR=1.3
# Where the weekend digest is posted. "web" is the chat on the web page, which the installer
# chooses because it works from the first day; a Telegram group's id (negative) moves it there.
# Leave empty to send no digest. RUNBOOK section 9 has the rest.
DIGEST_CHAT_ID=
DIGEST_DAY=thu
DIGEST_HOUR=18
# Hour (family time) at which "how was it?" follow-ups are posted the day after a plan.
FOLLOW_UP_HOUR=10

# --- The web page ---
# The whole bot in a browser: chat, ideas, plans, the family list, status and settings. The
# installer turns it on, since it is where everything else is set. Of the lines below, only
# WEB_TITLE and WEB_SESSION_DAYS can also be changed on the page: the rest decide how the page
# is reached, and a form cannot change the lock on its own door.
WEB_ENABLED=false
# 127.0.0.1 keeps it on this machine (reach it over Tailscale or an SSH tunnel). Use 0.0.0.0 to
# serve the network. Must stay above port 1024: the process runs unprivileged.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# The first password into the page, at least 12 characters: the installer makes one up. Once an
# admin chooses their own on the page, everybody signs in as themselves with their own and this
# one opens nothing. Until then it is required off the loopback and behind a proxy, and it guards
# the settings page and the keys too, so on a machine on the internet it is what stands between a
# stranger and your API bill; the daily spending limit is the next line of defence.
WEB_PASSWORD=
# Signs the login cookie. Leave empty and one is generated beside the database; set it when more
# than one process serves the page, so a login works against either.
WEB_SECRET_KEY=
# How long a login lasts before the password is asked again.
WEB_SESSION_DAYS=30
# Serve the network with no password at all. Only for a home network you trust.
WEB_ALLOW_NO_PASSWORD=false
# Set to true only when a reverse proxy you control (Caddy, nginx) sits in front, so the real
# client address and the HTTPS scheme are read from its headers. One hop is trusted: the proxy on
# this machine, or, in Docker, whatever reaches the port the compose file keeps to this machine.
WEB_TRUST_PROXY=false
# What the page calls itself.
WEB_TITLE=FamilyDB
# The domain name pointing at this machine, which Caddy gets a certificate for. The installer
# sets it, with WEB_TRUST_PROXY=true and, for Docker, COMPOSE_PROFILES=tls so that
# `docker compose up -d` starts Caddy as well. Leave empty when not serving the page over HTTPS.
WEB_DOMAIN=
# The port the page is served on over HTTPS. Empty is 443, the one every scan of the internet
# tries; another keeps the page out of those sweeps (it is not a lock). Set it with
# `maintain.sh https --port random`, which also moves Caddy and the firewall; with Docker, set it
# here and run `docker compose up -d`.
WEB_PUBLIC_PORT=

# --- Console and logging ---
# Who `familydb chat` speaks as when --as is not given. Default: the first admin.
CONSOLE_MEMBER=
# DEBUG also logs every HTTP request; a Telegram bot token in one is replaced with bot<token>.
LOG_LEVEL=INFO
